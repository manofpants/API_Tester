<Window x:Class="ApiTester.UpdateConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update available"
        Width="520"
        Height="460"
        MinWidth="420"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
    <DockPanel Margin="20">
        <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="0,16,0,0">
            <Button x:Name="UpdateButton"
                    DockPanel.Dock="Right"
                    Content="Update"
                    MinWidth="96"
                    Padding="14,6"
                    Margin="8,0,0,0"
                    IsDefault="True"
                    Click="UpdateButton_Click"/>
            <Button x:Name="CancelButton"
                    DockPanel.Dock="Right"
                    Content="Cancel"
                    MinWidth="96"
                    Padding="14,6"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
        </DockPanel>

        <StackPanel>
            <TextBlock x:Name="TitleText"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>
            <TextBlock x:Name="SubtitleText"
                       FontSize="12"
                       Margin="0,0,0,12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
            <TextBlock Text="Release notes"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>
            <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrushTheme}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10"
                    Height="260">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="NotesText"
                               FontFamily="Consolas"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
