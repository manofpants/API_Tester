<?xml version="1.0"?>
<SyntaxDefinition name="JsonDark" extensions=".json" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Digits" foreground="#B5CEA8" exampleText="42" />
  <Color name="ValueString" foreground="#CE9178" exampleText='"value"' />
  <Color name="PropertyKey" foreground="#9CDCFE" exampleText='"key"' />
  <Color name="Keywords" foreground="#569CD6" fontWeight="bold" exampleText="true" />
  <Color name="Punctuation" foreground="#D4D4D4" exampleText="{ }" />

  <RuleSet ignoreCase="false">
    <Keywords color="Keywords">
      <Word>true</Word>
      <Word>false</Word>
      <Word>null</Word>
    </Keywords>

    <Span color="PropertyKey">
      <Begin>"(?=([^\\"]|\\.)*"\s*:)</Begin>
      <End>"</End>
      <RuleSet>
        <Span begin="\\" end="." />
      </RuleSet>
    </Span>

    <Span color="ValueString">
      <Begin>"</Begin>
      <End>"</End>
      <RuleSet>
        <Span begin="\\" end="." />
      </RuleSet>
    </Span>

    <Rule color="Digits">
      \b0[xX][0-9a-fA-F]+|(\b\d+(\.[0-9]+)?|\.[0-9]+)([eE][+-]?[0-9]+)?
    </Rule>

    <Rule color="Punctuation">
      [{}\[\]:,]
    </Rule>
  </RuleSet>
</SyntaxDefinition>
