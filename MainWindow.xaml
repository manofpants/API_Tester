<Window x:Class="ApiTester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        mc:Ignorable="d"
        Title="API Tester"
        Height="720"
        Width="960"
        MinHeight="520"
        MinWidth="720"
        Background="{DynamicResource WindowBackgroundBrush}"
        Icon="pack://application:,,,/Resources/app.ico"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#E8F1F5"/>
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#F7FBFC"/>
        <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="StatusBackgroundBrush" Color="#D7E8EF"/>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1A333F"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#4A6A78"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#0D9488"/>
        <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrushTheme" Color="#B7CFD9"/>
        <SolidColorBrush x:Key="SplitterBrush" Color="#B7CFD9"/>
        <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#A8C2CD"/>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="True"/>
            <Setter Property="CanUserDeleteRows" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="28"/>
            <Setter Property="ColumnHeaderHeight" Value="28"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="RowBackground" Value="{DynamicResource SurfaceBackgroundBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource StatusBackgroundBrush}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrushTheme}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource BorderBrushTheme}"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
        <Style x:Key="HeaderCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
        <Style x:Key="HeaderCellTextBox" TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Settings"/>
        </Style>
        <Style x:Key="UpdateButton" TargetType="Button">
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="LayoutRoot" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition x:Name="RequestSectionRow" Height="*" MinHeight="180"/>
            <RowDefinition Height="6"/>
            <RowDefinition x:Name="ResponseSectionRow" Height="*" MinHeight="180"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
            <Button x:Name="SettingsButton"
                    DockPanel.Dock="Right"
                    Style="{StaticResource IconButton}"
                    Content="&#xE713;"
                    Click="SettingsButton_Click"/>
            <Button x:Name="UpdateButton"
                    DockPanel.Dock="Right"
                    Style="{StaticResource UpdateButton}"
                    Content="Check for updates"
                    Click="UpdateButton_Click"/>
            <TextBlock Style="{StaticResource PanelTitle}" Text="Request" Margin="0"/>
        </DockPanel>

        <!-- Request bar -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="MethodCombo"
                      Grid.Column="0"
                      Margin="0,0,8,0"
                      SelectedIndex="0">
                <ComboBoxItem Content="GET"/>
                <ComboBoxItem Content="POST"/>
                <ComboBoxItem Content="PUT"/>
                <ComboBoxItem Content="PATCH"/>
                <ComboBoxItem Content="DELETE"/>
            </ComboBox>

            <ComboBox x:Name="UrlBox"
                      Grid.Column="1"
                      Margin="0,0,8,0"
                      IsEditable="True"
                      IsTextSearchEnabled="False"
                      StaysOpenOnEdit="True"
                      VerticalContentAlignment="Center"
                      FontFamily="Consolas"
                      FontSize="13"
                      ToolTip="URL history (last 20)"
                      Text="https://api.example.com/endpoint"/>

            <Button x:Name="SendButton"
                    Grid.Column="2"
                    Content="Send"
                    MinWidth="88"
                    Click="SendButton_Click"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="{DynamicResource AccentTextBrush}"
                    BorderThickness="0"/>
        </Grid>

        <!-- Request tabs -->
        <TabControl x:Name="RequestTabs" Grid.Row="2" Margin="0,0,0,4">
            <TabItem Header="Headers">
                <DockPanel Background="{DynamicResource SurfaceBackgroundBrush}">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="8">
                        <Button Content="Add header" Click="AddHeader_Click" Padding="10,4"/>
                    </StackPanel>
                    <DataGrid x:Name="HeadersGrid"
                              Margin="4"
                              ItemsSource="{Binding}"
                              SelectionMode="Single"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              RowHeight="28">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="36">
                                <DataGridCheckBoxColumn.ElementStyle>
                                    <Style TargetType="CheckBox">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridCheckBoxColumn.ElementStyle>
                                <DataGridCheckBoxColumn.EditingElementStyle>
                                    <Style TargetType="CheckBox">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridCheckBoxColumn.EditingElementStyle>
                            </DataGridCheckBoxColumn>
                            <DataGridTextColumn Header="Key" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="*"
                                                ElementStyle="{StaticResource HeaderCellText}"
                                                EditingElementStyle="{StaticResource HeaderCellTextBox}"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="2*"
                                                ElementStyle="{StaticResource HeaderCellText}"
                                                EditingElementStyle="{StaticResource HeaderCellTextBox}"/>
                            <DataGridTemplateColumn Header="" Width="32" CanUserResize="False" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="&#xE74D;"
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="12"
                                                Width="24"
                                                Height="22"
                                                Padding="0"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                Cursor="Hand"
                                                ToolTip="Delete header"
                                                Click="DeleteHeaderRow_Click"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Body">
                <Border Background="{DynamicResource SurfaceBackgroundBrush}">
                    <avalonedit:TextEditor x:Name="BodyEditor"
                                           ShowLineNumbers="True"
                                           WordWrap="True"
                                           FontFamily="Consolas"
                                           FontSize="13"
                                           BorderThickness="0"
                                           Margin="4"
                                           Background="Transparent"
                                           HorizontalScrollBarVisibility="Auto"
                                           VerticalScrollBarVisibility="Auto"/>
                </Border>
            </TabItem>

            <TabItem Header="Auth">
                <StackPanel Margin="16" Background="{DynamicResource SurfaceBackgroundBrush}">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="Auth type"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <RadioButton x:Name="AuthNone"
                                     Content="None"
                                     IsChecked="True"
                                     Margin="0,0,16,0"
                                     Checked="AuthMode_Changed"/>
                        <RadioButton x:Name="AuthBearer"
                                     Content="Bearer token"
                                     Margin="0,0,16,0"
                                     Checked="AuthMode_Changed"/>
                        <RadioButton x:Name="AuthApiKey"
                                     Content="API key"
                                     Checked="AuthMode_Changed"/>
                    </StackPanel>

                    <StackPanel x:Name="BearerPanel" Visibility="Collapsed" Margin="0,0,0,12">
                        <TextBlock Style="{StaticResource SectionLabel}" Text="Token"/>
                        <TextBox x:Name="BearerTokenBox"/>
                    </StackPanel>

                    <StackPanel x:Name="ApiKeyPanel" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SectionLabel}" Text="Key"/>
                        <TextBox x:Name="ApiKeyBox" Margin="0,0,0,10"/>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="Secret"/>
                        <TextBox x:Name="ApiSecretBox" Margin="0,0,0,10"/>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="Add to"/>
                        <ComboBox x:Name="ApiKeyLocationCombo" Width="160" HorizontalAlignment="Left" SelectedIndex="0">
                            <ComboBoxItem Content="Header"/>
                            <ComboBoxItem Content="Query"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>

        <GridSplitter x:Name="SectionSplitter"
                      Grid.Row="3"
                      Height="6"
                      HorizontalAlignment="Stretch"
                      Background="{DynamicResource SplitterBrush}"
                      ResizeDirection="Rows"/>

        <!-- Response panel -->
        <DockPanel Grid.Row="4" Margin="0,4,0,0">
            <TextBlock DockPanel.Dock="Top"
                       Style="{StaticResource PanelTitle}"
                       Text="Response"/>
            <Border x:Name="ResponseStatusBorder"
                    DockPanel.Dock="Top"
                    Background="{DynamicResource StatusBackgroundBrush}"
                    Padding="10,8"
                    CornerRadius="4"
                    Margin="0,0,0,6">
                <TextBlock x:Name="ResponseStatusText"
                           Text="Ready"
                           FontFamily="Consolas"
                           FontSize="13"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>
            </Border>

            <TabControl x:Name="ResponseTabs">
                <TabItem Header="Body">
                    <Border Background="{DynamicResource SurfaceBackgroundBrush}">
                        <avalonedit:TextEditor x:Name="ResponseBodyEditor"
                                               IsReadOnly="True"
                                               ShowLineNumbers="True"
                                               WordWrap="True"
                                               FontFamily="Consolas"
                                               FontSize="13"
                                               BorderThickness="0"
                                               Margin="4"
                                               Background="Transparent"
                                               HorizontalScrollBarVisibility="Auto"
                                               VerticalScrollBarVisibility="Auto"/>
                    </Border>
                </TabItem>
                <TabItem Header="Headers">
                    <TextBox x:Name="ResponseHeadersBox"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             BorderThickness="0"
                             Margin="4"
                             Background="{DynamicResource SurfaceBackgroundBrush}"/>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Grid>
</Window>
