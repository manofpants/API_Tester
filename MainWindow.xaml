<Window x:Class="ApiTester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        mc:Ignorable="d"
        Title="API Tester"
        Height="720"
        Width="960"
        MinHeight="520"
        MinWidth="720"
        Background="{DynamicResource WindowBackgroundBrush}"
        Icon="pack://application:,,,/Resources/app.ico"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F4F5F7"/>
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="StatusBackgroundBrush" Color="#EEF1F5"/>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1F2937"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#555555"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrushTheme" Color="#D0D4DB"/>
        <SolidColorBrush x:Key="SplitterBrush" Color="#D0D4DB"/>
        <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#C5C9D0"/>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="True"/>
            <Setter Property="CanUserDeleteRows" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="RowBackground" Value="{DynamicResource SurfaceBackgroundBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource StatusBackgroundBrush}"/>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushTheme}"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Settings"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="LayoutRoot" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition x:Name="RequestSectionRow" Height="*" MinHeight="180"/>
            <RowDefinition Height="6"/>
            <RowDefinition x:Name="ResponseSectionRow" Height="*" MinHeight="180"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
            <Button x:Name="SettingsButton"
                    DockPanel.Dock="Right"
                    Style="{StaticResource IconButton}"
                    Content="&#xE713;"
                    Click="SettingsButton_Click"/>
            <TextBlock Style="{StaticResource PanelTitle}" Text="Request" Margin="0"/>
        </DockPanel>

        <!-- Request bar -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="MethodCombo"
                      Grid.Column="0"
                      Margin="0,0,8,0"
                      SelectedIndex="0">
                <ComboBoxItem Content="GET"/>
                <ComboBoxItem Content="POST"/>
                <ComboBoxItem Content="PUT"/>
                <ComboBoxItem Content="PATCH"/>
                <ComboBoxItem Content="DELETE"/>
            </ComboBox>

            <TextBox x:Name="UrlBox"
                     Grid.Column="1"
                     Margin="0,0,8,0"
                     VerticalContentAlignment="Center"
                     Text="https://api.example.com/endpoint"/>

            <Button x:Name="SendButton"
                    Grid.Column="2"
                    Content="Send"
                    MinWidth="88"
                    Click="SendButton_Click"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="{DynamicResource AccentTextBrush}"
                    BorderThickness="0"/>
        </Grid>

        <!-- Request tabs -->
        <TabControl x:Name="RequestTabs" Grid.Row="2" Margin="0,0,0,4">
            <TabItem Header="Headers">
                <DockPanel Background="{DynamicResource SurfaceBackgroundBrush}">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="8">
                        <Button Content="Add header" Click="AddHeader_Click" Margin="0,0,8,0" Padding="10,4"/>
                        <Button Content="Remove selected" Click="RemoveHeader_Click" Padding="10,4"/>
                    </StackPanel>
                    <DataGrid x:Name="HeadersGrid"
                              Margin="4"
                              ItemsSource="{Binding}"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
                            <DataGridTextColumn Header="Key" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Body">
                <TextBox x:Name="BodyBox"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         BorderThickness="0"
                         Margin="4"
                         Background="{DynamicResource SurfaceBackgroundBrush}"/>
            </TabItem>

            <TabItem Header="Auth">
                <StackPanel Margin="16" Background="{DynamicResource SurfaceBackgroundBrush}">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="Auth type"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <RadioButton x:Name="AuthNone"
                                     Content="None"
                                     IsChecked="True"
                                     Margin="0,0,16,0"
                                     Checked="AuthMode_Changed"/>
                        <RadioButton x:Name="AuthBearer"
                                     Content="Bearer token"
                                     Margin="0,0,16,0"
                                     Checked="AuthMode_Changed"/>
                        <RadioButton x:Name="AuthApiKey"
                                     Content="API key"
                                     Checked="AuthMode_Changed"/>
                    </StackPanel>

                    <StackPanel x:Name="BearerPanel" Visibility="Collapsed" Margin="0,0,0,12">
                        <TextBlock Style="{StaticResource SectionLabel}" Text="Token"/>
                        <TextBox x:Name="BearerTokenBox"/>
                    </StackPanel>

                    <StackPanel x:Name="ApiKeyPanel" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SectionLabel}" Text="Key"/>
                        <TextBox x:Name="ApiKeyBox" Margin="0,0,0,10"/>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="Secret"/>
                        <TextBox x:Name="ApiSecretBox" Margin="0,0,0,10"/>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="Add to"/>
                        <ComboBox x:Name="ApiKeyLocationCombo" Width="160" HorizontalAlignment="Left" SelectedIndex="0">
                            <ComboBoxItem Content="Header"/>
                            <ComboBoxItem Content="Query"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>

        <GridSplitter x:Name="SectionSplitter"
                      Grid.Row="3"
                      Height="6"
                      HorizontalAlignment="Stretch"
                      Background="{DynamicResource SplitterBrush}"
                      ResizeDirection="Rows"/>

        <!-- Response panel -->
        <DockPanel Grid.Row="4" Margin="0,4,0,0">
            <TextBlock DockPanel.Dock="Top"
                       Style="{StaticResource PanelTitle}"
                       Text="Response"/>
            <Border x:Name="ResponseStatusBorder"
                    DockPanel.Dock="Top"
                    Background="{DynamicResource StatusBackgroundBrush}"
                    Padding="10,8"
                    CornerRadius="4"
                    Margin="0,0,0,6">
                <TextBlock x:Name="ResponseStatusText"
                           Text="Ready"
                           FontFamily="Consolas"
                           FontSize="13"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>
            </Border>

            <TabControl x:Name="ResponseTabs">
                <TabItem Header="Body">
                    <Border Background="{DynamicResource SurfaceBackgroundBrush}">
                        <avalonedit:TextEditor x:Name="ResponseBodyEditor"
                                               IsReadOnly="True"
                                               ShowLineNumbers="True"
                                               WordWrap="True"
                                               FontFamily="Consolas"
                                               FontSize="13"
                                               BorderThickness="0"
                                               Margin="4"
                                               Background="Transparent"
                                               HorizontalScrollBarVisibility="Auto"
                                               VerticalScrollBarVisibility="Auto"/>
                    </Border>
                </TabItem>
                <TabItem Header="Headers">
                    <TextBox x:Name="ResponseHeadersBox"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             BorderThickness="0"
                             Margin="4"
                             Background="{DynamicResource SurfaceBackgroundBrush}"/>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Grid>
</Window>
